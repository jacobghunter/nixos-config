-- nested.lua — dedicated sandbox config, NOT derived from the host config

hl.config({ autogenerated = false })

hl.monitor({
    output = "WAYLAND-1",
    mode = "1920x1080",
    position = "0x0",
    scale = 1,
})

hl.config({
    general = { gaps_in = 4, gaps_out = 8 },
    decoration = { rounding = 6 },
    input = { kb_layout = "us" },
})

-- Minimal emergency-style binds so you're never stuck
hl.bind("ALT + Q", hl.dsp.exec_cmd("kitty"))
hl.bind("ALT + W", hl.dsp.window.close())
hl.bind("ALT + SHIFT + M", hl.dsp.exec_cmd("hyprctl dispatch exit"))

hl.bind("ALT + 1", hl.dsp.focus({workspace = 1}))
hl.bind("ALT + 2", hl.dsp.focus({workspace = 2}))
hl.bind("ALT + 3", hl.dsp.focus({workspace = 3}))


hl.on("hyprland.start", function()
    hl.exec_cmd("QUICKSHELL_BIN -p QML_PATH")
end)
